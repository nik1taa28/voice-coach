# Copy to .env and fill in. Never commit .env.
# Demo mode (fake providers) needs no keys.
# NOTE: nothing loads .env automatically yet. Export these in your shell, e.g.
#   ASR_PROVIDER=whisper python -m uvicorn backend.main:app
# ASR_PROVIDER=fake        # fake (default) | whisper (needs requirements-asr.txt)
# ASR_MODEL=tiny.en        # faster-whisper model size
# GEMINI_API_KEY=
# LLM_PROVIDER=fake        # fake (default) | gemini (needs GEMINI_API_KEY)
# GEMINI_MODEL=gemini-2.5-flash
# TTS_PROVIDER=fake        # fake (default, plays a beep) | browser (browser speechSynthesis speaks the text)
# FAKE_LLM_DELAY_S=0       # seconds between fake LLM pieces; try 1 to watch Pause / End cancel a slow reply
# Deadlines in seconds (M4). Starting guesses to tune with M5 data, not measurements:
# TIMEOUT_ASR_S=30
# TIMEOUT_LLM_FIRST_S=10   # until the first piece arrives
# TIMEOUT_LLM_TOTAL_S=30   # whole reply (includes inline TTS)
# TIMEOUT_TTS_S=5          # one sentence
# TIMEOUT_SUMMARY_S=30
# METRICS_WINDOW=1000     # samples kept per stage for /metrics percentiles; raise for load tests (loadtest/sweep.sh sets 200000)
